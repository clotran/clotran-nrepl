#!/bin/sh
# clotran-nrepl [--port N]
#
# Starts clotran with the nREPL server in the current directory -- a
# project's deps.edn resolved by clotran-deps, this package's source added
# -- and prints the line CIDER's jack-in waits for:
#
#   nREPL server started on port 7888 on host localhost - nrepl://localhost:7888
#
# so CIDER can run it as its jack-in command (clotran-mode sets that up in
# .cljf buffers). Stays up until killed. Port 0, the default, is any free one.
here=$(cd "$(dirname "$0")/.." && pwd)
port=0
[ "$1" = "--port" ] && port="$2"
# A tool is found on PATH, else beside this checkout, else in ~/.local/bin
# (make install's default): an Emacs started from the macOS Dock runs this
# with a PATH that has none of the user's own directories on it.
find_tool() { # name, the path beside this checkout
  command -v "$1" 2>/dev/null && return 0
  [ -x "$2" ] && { echo "$2"; return 0; }
  [ -x "$HOME/.local/bin/$1" ] && { echo "$HOME/.local/bin/$1"; return 0; }
  echo "clotran-nrepl: no $1 found (put it on PATH, or make install it)" >&2
  return 1
}
clotran=${CLOTRAN_PROGRAM:-$(find_tool clotran "$here/../clotran/clotran")} || exit 1
path=""
if [ -f deps.edn ]; then
  deps=${CLOTRAN_DEPS_PROGRAM:-$(find_tool clotran-deps "$here/../clotran-deps/bin/clotran-deps")} || exit 1
  path=$("$deps") || exit 1
fi
CLOTRAN_NREPL_PORT=$port CLOTRAN_PATH="${path:+$path:}$here/src" exec "$clotran" "$here/bin/serve.cljf" </dev/null
