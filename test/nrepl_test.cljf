;; test/nrepl_test.cljf -- the server, driven over a socket by a client
;; written with this package's own bencode. Run by test/run.sh.
(require '[clotran.nrepl.server :as srv] '[clotran.nrepl.bencode :as b] '[clotran.net :as net])

(def failures (atom 0))
(defn check [label got want]
  (if (= got want)
    (println "ok   -" label)
    (do (swap! failures inc) (println "FAIL -" label "\n  got: " (pr-str got) "\n  want:" (pr-str want)))))

(def s (srv/start! {:port 0}))
(def c (net/connect "127.0.0.1" (:port s)))
(def src (b/byte-source c))
(defn ask [m]
  (b/write-value c m)
  (loop [acc []]
    (let [r (dissoc (b/read-value src) "session")]
      (if (some #{"done"} (get r "status")) (conj acc r) (recur (conj acc r))))))

(check "bencode round trip, bytes counted"
       [(b/encode-str {"op" "eval" "l" ["λ" 1]}) (b/encode-str {"b" 1 "a" 2})]
       ["d1:ll2:λi1ee2:op4:evale" "d1:ai2e1:bi1ee"])
(def sid (get (first (ask {"op" "clone" "id" "1"})) "new-session"))
(check "clone answers a session" (string? sid) true)
(check "describe lists the ops"
       (sort (keys (get (first (ask {"op" "describe" "id" "2"})) "ops")))
       ["clone" "close" "complete" "completions" "describe" "eldoc" "eval" "info" "load-file" "lookup" "ns-list"])
(check "eval: output as printed, a value a form, the namespace, done"
       (ask {"op" "eval" "code" "(println \"hi λ\") (+ 1 2) (ns nt-other) (str *ns*)" "id" "3" "session" sid})
       [{"id" "3" "out" "hi λ\n"} {"id" "3" "ns" "user" "value" "nil"} {"id" "3" "ns" "user" "value" "3"}
        {"id" "3" "ns" "nt-other" "value" "nil"} {"id" "3" "ns" "nt-other" "value" "\"nt-other\""}
        {"id" "3" "status" ["done"]}])
(check "the session keeps its namespace and *1"
       (map #(get % "value") (ask {"op" "eval" "code" "(str *ns*) *1" "id" "4" "session" sid}))
       ["\"nt-other\"" "\"nt-other\"" nil])
(check "an error: err, ex and root-ex, eval-error, and the rest not run"
       (ask {"op" "eval" "code" "(/ 1 0) (println :never)" "id" "5" "session" sid})
       [{"id" "5" "err" "arithmetic_exception: Divide by zero\n"}
        {"id" "5" "ex" "arithmetic_exception" "root-ex" "arithmetic_exception" "status" ["eval-error"]}
        {"id" "5" "status" ["done"]}])
(check "load-file answers the last value"
       (ask {"op" "load-file" "file" "(def y 10) (* y 2)" "id" "6" "ns" "user"})
       [{"id" "6" "ns" "user" "value" "20"} {"id" "6" "status" ["done"]}])
(ask {"op" "eval" "code" "(require '[clojure.string :as str])" "ns" "user" "id" "7"})
(check "completions: core, an alias, a namespace"
       (mapv (fn [p] (mapv #(get % "candidate") (get (first (ask {"op" "completions" "prefix" p "ns" "user" "id" "8"})) "completions")))
             ["reduc" "str/jo" "clojure.string/jo"])
       [["reduce" "reduce-kv" "reduced" "reduced?" "reductions"] ["str/join"] ["clojure.string/join"]])
(check "info and lookup"
       [(select-keys (first (ask {"op" "info" "sym" "inc" "ns" "user" "id" "9"})) ["ns" "name" "arglists-str"])
        (get-in (first (ask {"op" "lookup" "sym" "inc" "ns" "user" "id" "10"})) ["info" "name"])]
       [{"ns" "clojure.core" "name" "inc" "arglists-str" "[x]"} "inc"])
(check "no info is said so" (get (first (ask {"op" "info" "sym" "nope-nothing" "ns" "user" "id" "11"})) "status") ["done" "no-info"])
(check "eldoc" (select-keys (first (ask {"op" "eldoc" "sym" "inc" "ns" "user" "id" "12"})) ["eldoc" "type"])
       {"eldoc" [["x"]] "type" "function"})
(check "ns-list names the loaded namespaces"
       (every? (set (get (first (ask {"op" "ns-list" "id" "13"})) "ns-list")) ["clojure.core" "user" "clotran.nrepl.server"]) true)
(check "CIDER's error display works: clojure.stacktrace is loaded"
       (let [rs (do (ask {"op" "eval" "code" "(no-such-thing)" "id" "16" "session" sid})
                    (ask {"op" "eval" "code" "(clojure.stacktrace/print-cause-trace *e)" "id" "17" "session" sid}))]
         [(boolean (some #(some-> (get % "out") (clojure.string/includes? "Unable to resolve symbol: no-such-thing")) rs))
          (last (map #(get % "status") rs))])
       [true ["done"]])
(check "describe gives no Clojure version-string, so CIDER does not take it for clj"
       (get-in (first (ask {"op" "describe" "id" "18"})) ["versions" "clojure" "version-string"])
       nil)
(check "an unknown op" (first (ask {"op" "bogus" "id" "14"})) {"id" "14" "status" ["error" "unknown-op" "done"]})
(check "close" (get (first (ask {"op" "close" "id" "15" "session" sid})) "status") ["done" "session-closed"])

(if-not (do (require (quote clotran.bind)) ((resolve (quote clotran.bind/fortran-compiler))))
  (println "skipped: no Fortran compiler, load-file of a package not checked")
  (let [dir (clotran-temp-dir (or (clotran.host.system/getenv "TMPDIR") "/tmp"))
        src (str dir "/tpkg.f90")
        write! (fn [k] (spit src (str "module tpkg\n  implicit none\ncontains\n  real(8) function twice(x)\n    real(8), intent(in) :: x\n    twice = " k " * x\n  end function twice\nend module tpkg\n")))
        load! (fn [id] (ask {"op" "load-file" "file" (slurp src) "file-path" src "file-name" "tpkg.f90" "id" id "session" sid}))]
    (spit (str dir "/package.edn") "{:name \"tpkg\" :sources [\"tpkg.f90\"]}")
    (write! 2)
    (check "load-file of a Fortran file builds its package and interns its routines"
           [(some #(get % "value") (load! "20"))
            (some #(get % "value") (ask {"op" "eval" "code" "(tpkg.raw/twice 21.0)" "id" "21" "session" sid}))]
           ["\"tpkg.raw\"" "42.0"])
    (write! 3)
    (check "load-file again after the source changed: rebuilt, the routine replaced, and said so"
           [(some #(get % "out") (load! "22"))
            (some #(get % "value") (ask {"op" "eval" "code" "(tpkg.raw/twice 21.0)" "id" "23" "session" sid}))]
           ["clotran: tpkg.raw rebuilt from its sources: 1 routines replaced, module state fresh\n" "63.0"])))

(net/close c)
(srv/stop! s)
(if (zero? @failures)
  (println "CLOTRAN-NREPL TESTS PASSED")
  (do (println "CLOTRAN-NREPL TESTS FAILED:" @failures) (clotran-exit 1)))
